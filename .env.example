# Copy to .env.local (never commit .env.local). These two values are safe for the browser.
# Supabase dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: lets an admin press "Run prediction" on the dashboard.
# Server-only secrets. Never prefix them with NEXT_PUBLIC_ and never commit real values.
# Token: GitHub -> Settings -> Developer settings -> Fine-grained tokens, this repository only,
# permission "Actions: Read and write".
GH_DISPATCH_TOKEN=
GITHUB_REPO=owner/repository-name
GITHUB_BRANCH=master
